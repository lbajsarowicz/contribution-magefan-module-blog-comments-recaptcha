{
    "name": "magefan/module-blog-comments-recaptcha",
    "description": "Add recaptcha to Magefan Blog Comments. Require magento/module-re-captcha-validation-api >= 1.0.0",
    "require": {
        "magefan/module-blog" : ">=2.14.0"
    },
    "type": "magento2-module",
    "version": "2.1.9",
    "autoload": {
        "files": [ "registration.php" ],
        "psr-4": {
            "Magefan\\BlogCommentsReCaptcha\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
